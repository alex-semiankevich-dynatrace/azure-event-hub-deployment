{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploy Event Hub namespaces across multiple Azure locations for Dynatrace log and event ingestion.",
        "subscription": {
          "resourceProviders": [
            "Microsoft.EventHub",
            "Microsoft.Authorization"
          ]
        },
        "resourceGroup": {
          "visible": false
        },
        "location": {
          "visible": true,
          "label": "Location",
          "toolTip": "Location for storing deployment metadata only. This is not used for Event Hub deployment. Select deployment locations in the next step."
        }
      }
    },
    "basics": [],
    "steps": [
      {
        "name": "dynatraceConfig",
        "label": "Dynatrace Configuration",
        "elements": [
          {
            "name": "dynatraceInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Provide your Dynatrace environment and monitoring configuration details. Select the service principal used for Dynatrace monitoring"
            }
          },
          {
            "name": "dtTenantId",
            "type": "Microsoft.Common.TextBox",
            "label": "Dynatrace Environment ID",
            "toolTip": "Your Dynatrace environment identifier (e.g. abc1234d)",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "dtConfigId",
            "type": "Microsoft.Common.TextBox",
            "label": "Monitoring Configuration ID",
            "toolTip": "Dynatrace monitoring configuration ID (UUID format)",
            "constraints": {
              "required": true,
              "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
              "validationMessage": "Must be a valid UUID (e.g., 592b6da9-9ce2-4ead-9e24-55bdae3bfaf7)"
            }
          },
          {
            "name": "dtServicePrincipal",
            "type": "Microsoft.Common.TextBox",
            "label": "Service Principal ID",
            "toolTip": "Azure service principal configured for monitoring in Dynatrace",
            "constraints": {
              "required": true,
              "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
              "validationMessage": "Must be a valid UUID (e.g., 592b6da9-9ce2-4ead-9e24-55bdae3bfaf7)"
            }
          }
        ]
      },
      {
        "name": "eventHubConfig",
        "label": "Event Hubs Configuration",
        "elements": [
          {
            "name": "namespaceInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Configure the Event Hub namespace SKU, capacity, and auto-inflate settings. Auto-inflate automatically scales throughput units based on load."
            }
          },
          {
                "name": "locationsApi",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(subscription().id, '/locations?api-version=2022-12-01')]"
                }
              },
          {
            "name": "eventHubNamespace",
            "type": "Microsoft.Common.Section",
            "label": "Event Hub Namespace Configuration",
            "elements": [
              {
                "name": "locations",
                "type": "Microsoft.Common.DropDown",
                "label": "Locations",
                "toolTip": "Select one or more locations to deploy Event Hub Namespaces.",
                "multiselect": true,
                "filter": true,
                "constraints": {
                  "allowedValues": "[map(steps('eventHubConfig').locationsApi.value, (item) => parse(concat('{\"label\":\"', item.displayName, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": true
                },
                "visible": true
              },
              {
                "name": "skuName",
                "type": "Microsoft.Common.DropDown",
                "label": "SKU",
                "toolTip": "Event Hub namespace pricing tier",
                "defaultValue": "Standard",
                "constraints": {
                  "required": true,
                  "allowedValues": [
                    {
                      "label": "Basic",
                      "value": "Basic"
                    },
                    {
                      "label": "Standard",
                      "value": "Standard"
                    },
                    {
                      "label": "Premium",
                      "value": "Premium"
                    }
                  ]
                }
              },
              {
                "name": "skuCapacity",
                "type": "Microsoft.Common.Slider",
                "label": "Throughput Units (Baseline)",
                "min": 1,
                "max": 20,
                "defaultValue": 1,
                "showStepMarkers": false,
                "toolTip": "Minimum/baseline throughput units (1-20). This is the starting capacity before auto-inflate.",
                "constraints": {
                  "required": true
                },
                "visible": true
              },
              {
                "name": "maximumThroughputUnits",
                "type": "Microsoft.Common.Slider",
                "label": "Maximum Throughput Units (Auto-inflate)",
                "min": "[steps('eventHubConfig').eventHubNamespace.skuCapacity]",
                "max": 40,
                "defaultValue": 10,
                "showStepMarkers": false,
                "toolTip": "Maximum throughput units for auto-inflate scaling (1-40). Must be greater than or equal to baseline throughput units.",
                "constraints": {
                  "required": true
                },
                "visible": "[equals(steps('eventHubConfig').eventHubNamespace.skuName, 'Standard')]"
              },
              {
                "name": "zoneRedundant",
                "type": "Microsoft.Common.CheckBox",
                "label": "Enable Zone Redundancy",
                "toolTip": "Requires Standard or Premium SKU. Provides high availability across availability zones.",
                "visible": "[or(equals(steps('eventHubConfig').eventHubNamespace.skuName, 'Standard'), equals(steps('eventHubConfig').eventHubNamespace.skuName, 'Premium'))]"
              }
            ]
          },

          {
            "name": "logsEventHub",
            "type": "Microsoft.Common.Section",
            "label": "Logs Event Hub Configuration",
            "elements": [
              {
                "name": "partitionCount",
                "type": "Microsoft.Common.TextBox",
                "label": "Partition Count",
                "defaultValue": "4",
                "toolTip": "Number of partitions (1-32)",
                "constraints": {
                  "required": true,
                  "regex": "^([1-9]|[1-2][0-9]|3[0-2])$",
                  "validationMessage": "Must be a number between 1 and 32"
                }
              },
              {
                "name": "retentionInDays",
                "type": "Microsoft.Common.Slider",
                "label": "Message Retention (days)",
                "min": 1,
                "max": 7,
                "defaultValue": 1,
                "showStepMarkers": true,
                "toolTip": "Number of days to retain log messages (1-7)",
                "constraints": {
                  "required": true
                }
              }
            ],
            "visible": true
          },
          {
            "name": "eventsEventHub",
            "type": "Microsoft.Common.Section",
            "label": "Events Event Hub Configuration",
            "elements": [
              {
                "name": "partitionCount",
                "type": "Microsoft.Common.DropDown",
                "label": "Partition Count",
                "toolTip": "Number of partitions (1 or 2)",
                "defaultValue": "1",
                "constraints": {
                  "required": true,
                  "allowedValues": [
                    {
                      "label": "1",
                      "value": "1"
                    },
                    {
                      "label": "2",
                      "value": "2"
                    }
                  ]
                }
              },
              {
                "name": "retentionInDays",
                "type": "Microsoft.Common.Slider",
                "label": "Message Retention (days)",
                "min": 1,
                "max": 7,
                "defaultValue": 1,
                "showStepMarkers": true,
                "toolTip": "Number of days to retain event messages (1-7)",
                "constraints": {
                  "required": true
                }
              }
            ],
            "visible": true
          }
        ]
      },
      {
        "name": "tags",
        "label": "Tags",
        "elements": [
          {
            "name": "tagsInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Optional: Add custom tags to all deployed resources. Standard tags (managed-by, dt-log-ingest-activated) are added automatically."
            }
          },
          {
            "name": "customTags",
            "type": "Microsoft.Common.TagsByResource",
            "toolTip": "Add custom tags to resources",
            "resources": [
              "Microsoft.EventHub/namespaces",
              "Microsoft.Resources/resourceGroups"
            ]
          }
        ]
      }
    ],
    "outputs": {
      "locations": "[steps('eventHubConfig').eventHubNamespace.locations]",
      "dtTenantId": "[steps('dynatraceConfig').dtTenantId]",
      "dtConfigId": "[steps('dynatraceConfig').dtConfigId]",
      "dtMonitoringServicePrincipalId": "[steps('dynatraceConfig').dtServicePrincipal]",
      "skuName": "[steps('eventHubConfig').eventHubNamespace.skuName]",
      "skuCapacity": "[steps('eventHubConfig').eventHubNamespace.skuCapacity]",
      "maximumThroughputUnits": "[steps('eventHubConfig').eventHubNamespace.maximumThroughputUnits]",
      "zoneRedundant": "[steps('eventHubConfig').eventHubNamespace.zoneRedundant]",
      "evhLogsPartitionCount": "[int(steps('eventHubConfig').logsEventHub.partitionCount)]",
      "evhLogsRetentionInDays": "[steps('eventHubConfig').logsEventHub.retentionInDays]",
      "evhEventsPartitionCount": "[int(steps('eventHubConfig').eventsEventHub.partitionCount)]",
      "evhEventsRetentionInDays": "[steps('eventHubConfig').eventsEventHub.retentionInDays]",
      "tags": "[steps('tags').customTags]"
    }
  }
}